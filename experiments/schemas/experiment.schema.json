{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://hgasp.local/schemas/experiment.schema.json",
    "title": "HGA-SP experiment manifest",
    "description": "A reproducible matrix of CLRP instances and random seeds.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "name",
        "binary",
        "output_root",
        "instances",
        "seeds",
        "limits",
        "resources",
        "sp"
    ],
    "properties": {
        "schema_version": {
            "const": 2
        },
        "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "description": "Stable experiment identifier and artifact-directory name."
        },
        "binary": {
            "type": "string",
            "minLength": 1,
            "description": "Solver executable, relative to the repository root unless absolute."
        },
        "output_root": {
            "type": "string",
            "minLength": 1,
            "description": "Artifact root, relative to the repository root unless absolute."
        },
        "gurobi_home": {
            "type": "string",
            "minLength": 1,
            "description": "Optional Gurobi installation prefix."
        },
        "instances": {
            "type": "array",
            "minItems": 1,
            "items": {
                "oneOf": [
                    {
                        "type": "string",
                        "minLength": 1,
                        "description": "Instance path with default metadata."
                    },
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "path"
                        ],
                        "properties": {
                            "id": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
                                "description": "Unique directory-safe identifier; defaults to the file stem."
                            },
                            "path": {
                                "type": "string",
                                "minLength": 1
                            },
                            "depot_config": {
                                "type": "string",
                                "minLength": 1
                            },
                            "best_known": {
                                "type": "number",
                                "default": 0
                            },
                            "is_optimal": {
                                "type": "boolean",
                                "default": false
                            }
                        }
                    }
                ]
            }
        },
        "seeds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
            }
        },
        "limits": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "time_seconds",
                "iterations"
            ],
            "properties": {
                "time_seconds": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647,
                    "description": "CPU-time limit passed to HGA-SP; 0 means unlimited."
                },
                "iterations": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647,
                    "description": "Iteration limit passed to HGA-SP."
                },
                "process_timeout_seconds": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "Optional external wall-clock safety timeout."
                }
            }
        },
        "resources": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "workers",
                "gurobi_threads"
            ],
            "properties": {
                "workers": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647,
                    "description": "Maximum concurrently running solver processes."
                },
                "gurobi_threads": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647,
                    "description": "CPU threads budgeted to each solver process."
                }
            }
        },
        "sp": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "trigger_frequency",
                "time_limit_seconds",
                "mip_gap",
                "seed",
                "max_pool_size",
                "output_flag",
                "mip_focus",
                "heuristics",
                "representation_route_limit"
            ],
            "properties": {
                "trigger_frequency": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                },
                "time_limit_seconds": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "mip_gap": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "seed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2000000000
                },
                "max_pool_size": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                },
                "output_flag": {
                    "type": "integer",
                    "enum": [
                        0,
                        1
                    ]
                },
                "mip_focus": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3
                },
                "heuristics": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "representation_route_limit": {
                    "type": "boolean"
                }
            }
        },
        "environment": {
            "type": "object",
            "default": {},
            "propertyNames": {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "additionalProperties": {
                "type": "string"
            },
            "description": "Non-secret environment overrides applied to every run."
        }
    }
}
