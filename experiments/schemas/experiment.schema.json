{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://hgasp.local/schemas/experiment.schema.json",
    "title": "HGA-SP experiment manifest",
    "description": "A reproducible matrix of CLRP or CLRP-TW instances and random seeds. Schema v2 manifests remain valid and are interpreted as problem_mode=clrp.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "name",
        "binary",
        "output_root",
        "instances",
        "seeds",
        "limits",
        "resources",
        "sp"
    ],
    "properties": {
        "schema_version": {
            "enum": [
                2,
                3
            ]
        },
        "problem_mode": {
            "type": "string",
            "enum": [
                "clrp",
                "clrp-tw"
            ],
            "description": "Mathematical problem mode. Required by schema v3; schema v2 implies clrp."
        },
        "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "description": "Stable experiment identifier and artifact-directory name."
        },
        "binary": {
            "type": "string",
            "minLength": 1,
            "description": "Solver executable, relative to the repository root unless absolute."
        },
        "output_root": {
            "type": "string",
            "minLength": 1,
            "description": "Artifact root, relative to the repository root unless absolute."
        },
        "gurobi_home": {
            "type": "string",
            "minLength": 1,
            "description": "Optional Gurobi installation prefix."
        },
        "instances": {
            "type": "array",
            "minItems": 1,
            "items": {
                "oneOf": [
                    {
                        "type": "string",
                        "minLength": 1,
                        "description": "Instance path with default metadata."
                    },
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "path"
                        ],
                        "properties": {
                            "id": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
                                "description": "Unique directory-safe identifier; defaults to the file stem."
                            },
                            "path": {
                                "type": "string",
                                "minLength": 1
                            },
                            "depot_config": {
                                "type": "string",
                                "minLength": 1
                            },
                            "best_known": {
                                "type": "number",
                                "minimum": 0,
                                "default": 0
                            },
                            "is_optimal": {
                                "type": "boolean",
                                "default": false
                            },
                            "stop_at_reference": {
                                "type": "boolean",
                                "default": true,
                                "description": "Whether a proven optimal reference should terminate the solver early. Set false only for functional tests that must reach later phases."
                            },
                            "reference": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                    "status"
                                ],
                                "properties": {
                                    "status": {
                                        "type": "string",
                                        "enum": [
                                            "unknown",
                                            "bks",
                                            "optimal"
                                        ]
                                    },
                                    "value": {
                                        "type": [
                                            "number",
                                            "null"
                                        ]
                                    },
                                    "lower_bound": {
                                        "type": [
                                            "number",
                                            "null"
                                        ]
                                    },
                                    "source": {
                                        "type": "string",
                                        "minLength": 1
                                    },
                                    "distance_policy": {
                                        "type": "string",
                                        "minLength": 1
                                    }
                                },
                                "allOf": [
                                    {
                                        "if": {
                                            "properties": {
                                                "status": {
                                                    "const": "unknown"
                                                }
                                            }
                                        },
                                        "then": {
                                            "properties": {
                                                "value": {
                                                    "type": "null"
                                                }
                                            }
                                        },
                                        "else": {
                                            "required": [
                                                "value"
                                            ],
                                            "properties": {
                                                "value": {
                                                    "type": "number",
                                                    "exclusiveMinimum": 0
                                                }
                                            }
                                        }
                                    }
                                ]
                            }
                        },
                        "not": {
                            "anyOf": [
                                {
                                    "required": [
                                        "reference",
                                        "best_known"
                                    ]
                                },
                                {
                                    "required": [
                                        "reference",
                                        "is_optimal"
                                    ]
                                }
                            ]
                        }
                    }
                ]
            }
        },
        "seeds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
            }
        },
        "limits": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "time_seconds",
                "iterations"
            ],
            "properties": {
                "time_seconds": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647,
                    "description": "CPU-time limit passed to HGA-SP; 0 means unlimited."
                },
                "iterations": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647,
                    "description": "Iteration limit passed to HGA-SP."
                },
                "process_timeout_seconds": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "Optional external wall-clock safety timeout."
                }
            }
        },
        "resources": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "workers",
                "gurobi_threads"
            ],
            "properties": {
                "workers": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647,
                    "description": "Maximum concurrently running solver processes."
                },
                "gurobi_threads": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1024,
                    "description": "CPU threads budgeted to each solver process."
                },
                "allow_smt": {
                    "type": "boolean",
                    "default": false,
                    "description": "Explicitly permit separate solver processes on SMT siblings. When false or omitted, workers are limited to affinity-visible physical cores."
                }
            }
        },
        "sp": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "trigger_frequency",
                "time_limit_seconds",
                "mip_gap",
                "seed",
                "max_pool_size",
                "output_flag",
                "mip_focus",
                "heuristics",
                "representation_route_limit"
            ],
            "properties": {
                "trigger_frequency": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                },
                "trigger_offset": {
                    "oneOf": [
                        {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 2147483646
                        },
                        {
                            "const": "deterministic"
                        }
                    ],
                    "default": "deterministic",
                    "description": "Per-run SP trigger offset. Matrix runs default to a stable run-id-derived offset that preserves the number of scheduled SP calls."
                },
                "time_limit_seconds": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "local_enabled": {
                    "type": "boolean",
                    "default": true
                },
                "local_trigger_frequency": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647,
                    "default": 10000
                },
                "local_time_limit_seconds": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "default": 30
                },
                "adaptive_trigger_enabled": {
                    "type": "boolean",
                    "default": true
                },
                "adaptive_minimum_interval": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647,
                    "default": 5000
                },
                "adaptive_local_new_columns": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647,
                    "default": 250
                },
                "adaptive_local_stagnation": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647,
                    "default": 5000
                },
                "adaptive_global_stagnation": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647,
                    "default": 20000
                },
                "adaptive_utility_ema_weight": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1,
                    "default": 0.25
                },
                "adaptive_high_utility_threshold": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "default": 0.001
                },
                "lp_dual_feedback_enabled": {
                    "type": "boolean",
                    "default": true
                },
                "lp_time_limit_seconds": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "default": 10
                },
                "persistent_lp_enabled": {
                    "type": "boolean",
                    "default": true
                },
                "solution_pool_size": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000,
                    "default": 5
                },
                "solution_pool_gap": {
                    "type": "number",
                    "minimum": 0,
                    "default": 0.02
                },
                "solution_pool_search_mode": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2,
                    "default": 2
                },
                "diverse_injection_count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000,
                    "default": 3
                },
                "adaptive_search_allocation_enabled": {
                    "type": "boolean",
                    "default": true
                },
                "adaptive_population_exploration": {
                    "type": "number",
                    "minimum": 0,
                    "default": 0.25
                },
                "adaptive_population_diversity_weight": {
                    "type": "number",
                    "minimum": 0,
                    "default": 0.1
                },
                "adaptive_population_column_weight": {
                    "type": "number",
                    "minimum": 0,
                    "default": 0.05
                },
                "adaptive_search_ema_weight": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1,
                    "default": 0.2
                },
                "adaptive_mutation_minimum_percent": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100,
                    "default": 5
                },
                "adaptive_mutation_maximum_percent": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100,
                    "default": 40
                },
                "work_limit": {
                    "type": "number",
                    "minimum": 0,
                    "default": 0,
                    "description": "Optional deterministic Gurobi work-unit limit; zero leaves WorkLimit unset."
                },
                "mip_gap": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "seed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2000000000
                },
                "max_pool_size": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                },
                "output_flag": {
                    "type": "integer",
                    "enum": [
                        0,
                        1
                    ]
                },
                "mip_focus": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3
                },
                "heuristics": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "wls_token_duration_minutes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2000000000,
                    "default": 0,
                    "description": "Optional WLS token-duration override. Zero keeps Gurobi's automatic policy."
                },
                "wls_token_refresh": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0.9
                },
                "client_log_level": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3,
                    "default": 1,
                    "description": "Compute Server/WLS client logging; level 1 records errors only."
                },
                "server_timeout_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2000000000,
                    "default": 30
                },
                "environment_max_attempts": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10,
                    "default": 3
                },
                "environment_retry_base_milliseconds": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 60000,
                    "default": 250
                },
                "representation_route_limit": {
                    "type": "boolean"
                },
                "require_success": {
                    "type": "boolean",
                    "default": false,
                    "description": "Fail the run unless this attempt logs both '[SP Result] status=' and '[SP Success]'. Intended for a dedicated functional smoke test."
                }
            }
        },
        "environment": {
            "type": "object",
            "default": {},
            "propertyNames": {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "additionalProperties": {
                "type": "string"
            },
            "description": "Non-secret environment overrides applied to every run."
        },
        "validation": {
            "type": "object",
            "additionalProperties": false,
            "default": {
                "required": false
            },
            "properties": {
                "required": {
                    "type": "boolean",
                    "default": false
                },
                "absolute_tolerance": {
                    "type": "number",
                    "minimum": 0,
                    "default": 1e-09
                },
                "relative_tolerance": {
                    "type": "number",
                    "minimum": 0,
                    "default": 1e-09
                }
            }
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "schema_version": {
                        "const": 3
                    }
                }
            },
            "then": {
                "required": [
                    "problem_mode"
                ]
            },
            "else": {
                "properties": {
                    "problem_mode": {
                        "const": "clrp"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "problem_mode": {
                        "const": "clrp-tw"
                    }
                },
                "required": [
                    "problem_mode"
                ]
            },
            "then": {
                "required": [
                    "validation"
                ],
                "properties": {
                    "validation": {
                        "required": [
                            "required"
                        ],
                        "properties": {
                            "required": {
                                "const": true
                            }
                        }
                    }
                }
            }
        }
    ]
}
